# Copy to .secrets/gateway.env (or run scripts/provision-local.py, which
# generates this plus TLS automatically) and fill in the blanks. Never
# commit a real copy of this file.

EDGE_ROOT=/path/to/limen-gateway

# Device-facing API — what embedded devices call.
EDGE_BIND=0.0.0.0
EDGE_PORT=8443
EDGE_TLS_CERT=/path/to/.secrets/tls/server.crt
EDGE_TLS_KEY=/path/to/.secrets/tls/server.key

# Admin API — mint/revoke device identities. Loopback-only by default;
# only widen EDGE_ADMIN_BIND if you also set EDGE_ADMIN_TOKEN and TLS,
# and only allow the flasher's exact origin via EDGE_ADMIN_CORS_ORIGIN.
EDGE_ADMIN_BIND=127.0.0.1
EDGE_ADMIN_PORT=8444
EDGE_ADMIN_TLS_CERT=
EDGE_ADMIN_TLS_KEY=
EDGE_ADMIN_TOKEN=
EDGE_ADMIN_CORS_ORIGIN=

EDGE_DATABASE=/path/to/limen-gateway/data/gateway.sqlite3

# Backend: "openai_api" (generic, needs OPENAI_API_KEY) or "codex"
# (local ChatGPT-subscription Codex CLI, no API key involved at all).
EDGE_BACKEND=openai_api
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/responses

EDGE_CODEX_BIN=codex
EDGE_CODEX_MODEL=
EDGE_AGENT_WORK_DIR=/path/to/limen-gateway/runtime/agent-empty

EDGE_REQUEST_TIMEOUT_SECONDS=180
EDGE_REQUESTS_PER_MINUTE=10
EDGE_MAX_CONCURRENT=2
EDGE_MAX_REQUEST_BYTES=32768
EDGE_MAX_OUTPUT_CHARS=12000
